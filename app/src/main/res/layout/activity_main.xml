<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal (dashboard): total del mes, presupuesto y gastos recientes -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Barra superior: saludo + ajustes + perfil -->
        <LinearLayout
            style="@style/BarraSuperior"
            android:layout_height="72dp"
            android:paddingStart="@dimen/margen_pantalla">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSaludo"
                    style="@style/TextoSubtitulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_saludo" />

                <TextView
                    style="@style/TituloBarra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_titulo" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btnAjustes"
                style="@style/IconoAccion"
                android:contentDescription="@string/desc_ajustes"
                android:src="@drawable/ic_ajustes" />

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="@dimen/tamano_avatar"
                android:layout_height="@dimen/tamano_avatar"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_circulo_primario"
                android:contentDescription="@string/desc_perfil"
                android:padding="8dp"
                android:src="@drawable/ic_persona"
                app:tint="@color/blanco" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingTop="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla"
                android:paddingBottom="96dp">

                <!-- Tarjeta: total del mes y presupuesto -->
                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextoSeccion"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/main_total_mes"
                            android:textColor="@color/texto_secundario" />

                        <TextView
                            android:id="@+id/txtMesActual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip"
                            android:paddingStart="10dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="4dp"
                            android:text="@string/main_mes_ejemplo"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTotalMes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_chico"
                        android:text="@string/main_monto_ejemplo"
                        android:textColor="@color/texto_principal"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progressPresupuesto"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="@dimen/espacio_medio"
                        android:max="100"
                        android:progress="85"
                        android:progressBackgroundTint="@color/divisor"
                        android:progressTint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_chico"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtRestante"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/main_restante_ejemplo"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPresupuesto"
                            style="@style/TextoSubtitulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/main_presupuesto_ejemplo" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Accesos rápidos: lista completa y resumen -->

                <!-- Encabezado de gastos recientes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_grande"
                    android:layout_marginBottom="@dimen/espacio_chico"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/main_recientes"
                        android:textColor="@color/texto_principal"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtVerTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="6dp"
                        android:text="@string/main_ver_todos"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Mensaje cuando no hay gastos (se muestra desde Java) -->
                <TextView
                    android:id="@+id/txtSinGastos"
                    style="@style/TextoSubtitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/espacio_grande"
                    android:text="@string/sin_gastos"
                    android:visibility="gone" />

                <!-- Contenedor de gastos recientes.
                     Los <include> son solo de vista previa; desde Java se limpiará
                     (removeAllViews) y se llenará inflando item_gasto.xml -->
                <LinearLayout
                    android:id="@+id/layoutRecientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_gasto" />

                    <include layout="@layout/item_gasto" />

                    <include layout="@layout/item_gasto" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Botón flotante para agregar gasto -->
    <ImageButton
        android:id="@+id/btnAgregarGasto"
        android:layout_width="@dimen/tamano_fab"
        android:layout_height="@dimen/tamano_fab"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/margen_pantalla"
        android:background="@drawable/bg_circulo_primario"
        android:contentDescription="@string/desc_agregar"
        android:elevation="6dp"
        android:src="@drawable/ic_agregar"
        app:tint="@color/blanco" />

</FrameLayout>
