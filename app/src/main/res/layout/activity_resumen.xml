<?xml version="1.0" encoding="utf-8"?>
<!-- Resumen de gastos del mes agrupados por categoría (barras con ProgressBar) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".activities.ResumenActivity">

    <!-- Barra superior -->
    <LinearLayout style="@style/BarraSuperior">

        <ImageView
            android:id="@+id/btnAtras"
            style="@style/IconoAccion"
            android:contentDescription="@string/desc_atras"
            android:src="@drawable/ic_atras" />

        <TextView
            style="@style/TituloBarra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/resumen_titulo" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <!-- Total del mes -->
            <LinearLayout
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextoSeccion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/resumen_total"
                        android:textColor="@color/texto_secundario" />

                    <TextView
                        android:id="@+id/txtMesResumen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/main_mes_ejemplo"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtTotalResumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_chico"
                    android:text="@string/main_monto_ejemplo"
                    android:textColor="@color/texto_principal"
                    android:textSize="34sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                style="@style/TextoSeccion"
                android:layout_marginTop="@dimen/espacio_grande"
                android:layout_marginBottom="@dimen/espacio_chico"
                android:text="@string/etiqueta_categoria" />

            <TextView
                android:id="@+id/txtSinDatos"
                style="@style/TextoSubtitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="@dimen/espacio_grande"
                android:text="@string/sin_gastos"
                android:visibility="gone" />

            <!-- Contenedor de categorías.
                 Los <include> son solo de vista previa; desde Java se limpiará
                 y se llenará inflando item_categoria_resumen.xml -->
            <LinearLayout
                android:id="@+id/layoutCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/item_categoria_resumen" />

                <include layout="@layout/item_categoria_resumen" />

                <include layout="@layout/item_categoria_resumen" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
