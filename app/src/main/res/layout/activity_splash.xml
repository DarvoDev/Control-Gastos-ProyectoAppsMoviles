<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de inicio: muestra el logo mientras se revisa si hay sesión activa -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/margen_pantalla"
    tools:context=".activities.SplashActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_circulo_primario"
        android:contentDescription="@string/desc_logo"
        android:padding="28dp"
        android:src="@drawable/ic_cartera"
        app:tint="@color/blanco" />

    <TextView
        android:id="@+id/txtNombreApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_grande"
        android:text="@string/app_name"
        android:textColor="@color/texto_principal"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtLema"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_chico"
        android:text="@string/app_lema"
        android:textColor="@color/texto_secundario"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/progressSplash"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="48dp"
        android:indeterminateTint="?attr/colorPrimary" />

</LinearLayout>
